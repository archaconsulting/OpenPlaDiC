@model IEnumerable<OpenPlaDiC.Core.Models.Entity>
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid px-4 mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="h3 mb-0 text-gray-800">Welcome, @User.Identity.Name</h1>
            <p class="text-muted">Select a module to manage your information.</p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h6 class="m-0 font-weight-bold text-primary"><i class="bi bi-graph-up"></i> Actividad de Accesos (Últimos 7 días)</h6>
                </div>
                <div class="card-body">
                    <canvas id="accessChart" style="max-height: 250px;"></canvas>
                </div>
            </div>
        </div>
    </div>


    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-shield-lock display-1 text-muted"></i>
                <p class="mt-3">You don't have access to any modules yet. Please contact your administrator.</p>
            </div>
        }
        else
        {
            @foreach (var entity in Model)
            {
                <div class="col-xl-3 col-md-4 col-sm-6">
                    <a>
                        <div class="card h-100 border-0 shadow-sm dashboard-card">
                            <div class="card-body text-center p-4">
                                <div class="icon-circle bg-primary bg-opacity-10 text-primary mb-3 mx-auto">
                                    
                                </div>
                                <h5 class="card-title text-dark fw-bold">@entity.Label</h5>
                                <p class="card-text text-muted small">Manage all @entity.Label records</p>
                            </div>
                        </div>
                    </a>
                </div>
            }
        }
    </div>
</div>

<style>
    .dashboard-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .dashboard-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        cursor: pointer;
    }
    .icon-circle {
        width: 80px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }
</style>


<!-- Agregar antes del listado de módulos -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h6 class="m-0 font-weight-bold text-primary"><i class="bi bi-graph-up"></i> Actividad de Accesos (Últimos 7 días)</h6>
            </div>
            <div class="card-body">
                <canvas id="accessChart" style="max-height: 250px;"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {



    <script>
        const ctx = document.getElementById('accessChart').getContext('2d');
        
        // Procesar datos desde ViewBag
        const rawData = @Html.Raw(Json.Serialize(ViewBag.ChartData));
        const labels = [...new Set(rawData.map(d => new Date(d.date).toLocaleDateString()))].sort();
        
        const successData = labels.map(l => {
            const match = rawData.find(d => new Date(d.date).toLocaleDateString() === l && d.status === 'SUCCESS');
            return match ? match.count : 0;
        });

        const failedData = labels.map(l => {
            const match = rawData.find(d => new Date(d.date).toLocaleDateString() === l && d.status === 'FAILED');
            return match ? match.count : 0;
        });

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Éxitos',
                    data: successData,
                    borderColor: '#198754',
                    backgroundColor: 'rgba(25, 135, 84, 0.1)',
                    fill: true,
                    tension: 0.4
                },
                {
                    label: 'Fallidos',
                    data: failedData,
                    borderColor: '#dc3545',
                    backgroundColor: 'rgba(220, 53, 69, 0.1)',
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });
    </script>
}
