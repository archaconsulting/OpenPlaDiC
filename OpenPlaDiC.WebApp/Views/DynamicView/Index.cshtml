@using OpenPlaDiC.Core.Models
@using OpenPlaDiC.WebApp.Controllers
@* ⚡ BLINDAJE: Especificamos el Namespace exacto del ViewModel *@
@model IEnumerable<DynamicViewRowViewModel>

@{
    ViewData["Title"] = "Dynamic Views Manager";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-code-square text-primary"></i> Dynamic Views Manager</h2>
        <a asp-action="Editor" class="btn btn-success shadow-sm fw-bold">
            <i class="bi bi-plus-circle me-1"></i> Create New View
        </a>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-success shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow border-1">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 35%;">Label / Name</th>
                        <th style="width: 15%;">Type</th>
                        <th style="width: 15%;">Status</th>
                        <th style="width: 15%;">File Sync</th>
                        <th class="text-end" style="width: 20%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        // Desempaquetamos la Tupla de forma segura y tipada
                        var viewData = item.Data;
                        bool fileExists = item.FileExists;

                        <tr>
                            <td>
                                <strong class="text-dark">@viewData.Label</strong><br />
                                <small class="text-muted font-monospace">@viewData.Name</small>
                            </td>
                            <td>
                                <span class="badge bg-secondary px-2 py-1 text-uppercase">@viewData.ViewType</span>
                            </td>
                            <td>
                                <div class="form-check form-switch">
                                    <input class="form-check-input cursor-pointer" 
                                           type="checkbox" 
                                           id="switch-@viewData.Id" 
                                           checked="@viewData.IsActive" 
                                           onclick="toggleViewStatus('@viewData.Id', this)" />
                                    <label class="form-check-label small fw-bold text-secondary" id="label-switch-@viewData.Id" for="switch-@viewData.Id">
                                        @(viewData.IsActive ? "Active" : "Inactive")
                                    </label>
                                </div>
                            </td>
                            <td>
                                @if (fileExists)
                                {
                                    <span class="text-success small fw-semibold" title="File is physically present on server disk">
                                        <i class="bi bi-check-circle-fill"></i> Synchronized
                                    </span>
                                }
                                else
                                {
                                    <span class="text-danger small fw-semibold" title="File missing on Views/Custom folder">
                                        <i class="bi bi-exclamation-triangle-fill"></i> Missing File
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group shadow-sm" role="group">
                                    @* 🚀 LANZAMIENTO EN VIVO: Solo si está activa y es de tipo VIEW *@
                                    @if (viewData.IsActive && viewData.ViewType == "VIEW")
                                    {
                                        <a href="/Custom/@viewData.Name" 
                                           target="_blank" 
                                           class="btn btn-sm btn-success" 
                                           title="Launch and test dynamic view in new tab">
                                            <i class="bi bi-rocket-takeoff-fill text-white"></i> Launch
                                        </a>
                                    }
                                    else if (viewData.IsActive && viewData.ViewType == "API")
                                    {
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-success" 
                                                onclick="testDynamicAPI('@viewData.Name')" 
                                                title="Test API Endpoint via Postman-Style">
                                            <i class="bi bi-lightning-charge-fill"></i> Test API
                                        </button>
                                    }

                                    <a asp-action="Editor" asp-route-id="@viewData.Id" class="btn btn-sm btn-outline-primary" title="Edit Source Code">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    
                                    <button type="button" onclick="deleteView('@viewData.Id', '@viewData.Name')" class="btn btn-sm btn-outline-danger" title="Delete from Kernel">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .cursor-pointer { cursor: pointer; }
    .swal2-wide { width: 650px !important; }
    .font-monospace { font-family: SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace !important; }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // 1. CONTROL DE ESTADO LÓGICO Y FÍSICO VIA AJAX
        function toggleViewStatus(id, switchElement) {
            switchElement.disabled = true;

            $.post('@Url.Action("ToggleStatus")', { id: id }, function (res) {
                switchElement.disabled = false;
                
                if (res.isSuccess) {
                    let label = document.getElementById(`label-switch-${id}`);
                    label.innerText = res.isActive ? "Active" : "Inactive";
                    
                    // Ejecutamos la receta de Toast flotante de 2 segundos
                    const Toast = Swal.mixin({
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 2000,
                        timerProgressBar: true
                    });
                    Toast.fire({
                        icon: 'success',
                        title: res.message
                    }).then(() => {
                        location.reload(); // Recarga sutil para actualizar el semáforo de archivos físicos
                    });
                } else {
                    switchElement.checked = !switchElement.checked;
                    Swal.fire('Synchronization Error', res.message, 'error');
                }
            }).fail(function() {
                switchElement.disabled = false;
                switchElement.checked = !switchElement.checked;
                Swal.fire('Network Error', 'No se logró comunicar con la pasarela del Kernel.', 'error');
            });
        }

        // 2. ELIMINACIÓN DE COMPONENTES DE METADATA
        function deleteView(id, name) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You are about to delete the view from Kernel and disk: " + name,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("Delete")', { id: id }, function (res) {
                        if (res.isSuccess) {
                            Swal.fire('Deleted!', 'The dynamic component has been removed.', 'success').then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire('Error', res.message, 'error');
                        }
                    });
                }
            })
        }

        // 3. ENTORNO DE PRUEBAS PARA MICROSERVICIOS INTERNOS (APIs)
        function testDynamicAPI(apiName) {
            Swal.fire({
                title: `Test API: ${apiName}`,
                text: '¿Deseas disparar una petición de prueba (POST) sin parámetros a este microservicio?',
                icon: 'info',
                showCancelButton: true,
                confirmButtonColor: '#198754',
                confirmButtonText: '<i class="bi bi-play-fill"></i> Fire Request'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Consumo directo de tu wrapper global APIService del site.js
                    if (typeof APIService !== 'undefined') {
                        APIService.exec(apiName, [], function(response) {
                            Swal.fire({
                                title: 'Kernel API Response',
                                html: `<pre class="text-start bg-dark text-success p-3 rounded font-monospace small" style="max-height: 300px; overflow-y: auto;">${JSON.stringify(response, null, 2)}</pre>`,
                                icon: response.isSuccess ? 'success' : 'error',
                                customClass: { popup: 'swal2-wide' }
                            });
                        });
                    } else {
                        Swal.fire('Infrastructure Error', 'APIService core not detected on site.js', 'error');
                    }
                }
            });
        }
    </script>
}