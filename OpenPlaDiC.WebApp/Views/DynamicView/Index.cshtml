@using OpenPlaDiC.Core.Models
@model IEnumerable<DynamicView>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-code-square"></i> Dynamic Views Manager</h2>
        <a asp-action="Editor" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Create New View
        </a>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Label / Name</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>File Sync</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@item.Label</strong><br />
                                <small class="text-muted">@item.Name</small>
                            </td>
                            <td>
                                <span class="badge bg-secondary">@item.ViewType</span>
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="text-success" title="File synchronized">
                                        <i class="bi bi-check-circle-fill"></i> Synchronized
                                    </span>
                                }
                                else
                                {
                                    <span class="text-danger" title="File missing on server">
                                        <i class="bi bi-exclamation-triangle-fill"></i> Missing File
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Editor" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <button onclick="deleteView('@item.Id', '@item.Name')" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function deleteView(id, name) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You are about to delete the view: " + name,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("Delete")', { id: id }, function (res) {
                        if (res.isSuccess) {
                            location.reload();
                        } else {
                            Swal.fire('Error', res.message, 'error');
                        }
                    });
                }
            })
        }
    </script>
}
