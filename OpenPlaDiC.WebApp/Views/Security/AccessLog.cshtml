@model IEnumerable<OpenPlaDiC.Core.Models.LoginLog>
@{
    ViewData["Title"] = "Auditoría de Accesos";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-shield-shaded text-primary"></i> Auditoría de Accesos</h2>
        <button class="btn btn-outline-secondary btn-sm" onclick="location.reload()">
            <i class="bi bi-arrow-clockwise"></i> Actualizar
        </button>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Fecha y Hora</th>
                        <th>Usuario</th>
                        <th>Estado</th>
                        <th>IP / Dispositivo</th>
                        <th>Detalles</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td>
                                <span class="fw-bold">@log.LoginDate.ToString("dd/MM/yyyy")</span><br />
                                <small class="text-muted">@log.LoginDate.ToString("HH:mm:ss")</small>
                            </td>
                            <td>
                                <i class="bi bi-person-circle me-1"></i> @log.Username
                            </td>
                            <td>
                                @if (log.Status == "SUCCESS")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success">
                                        <i class="bi bi-check-circle-fill"></i> ÉXITO
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger">
                                        <i class="bi bi-x-octagon-fill"></i> FALLIDO
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@log.IPAddress</span>
                                <div class="small text-truncate text-muted" style="max-width: 250px;" title="@log.UserAgent">
                                    @log.UserAgent
                                </div>
                            </td>
                            <td>
                                <small class="text-muted">@log.Message</small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
