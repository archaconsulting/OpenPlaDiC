@model IEnumerable<OpenPlaDiC.Core.Models.Profile>

<div class="row row-cols-1 row-cols-md-3 g-4 mt-2">
    @foreach (var profile in Model)
    {
        <div class="col">
            <div class="card h-100 border-0 shadow-sm border-top border-primary border-4">
                <div class="card-body">
                    <h5 class="card-title">@profile.Name</h5>
                    <p class="text-muted small">Members: @profile.UserProfiles?.Count()</p>
                </div>
                <div class="card-footer bg-transparent">
                    <a href="#" class="btn btn-sm btn-primary w-100">Configure Permissions</a>
                </div>
            </div>
        </div>
    }
</div>
