@model IEnumerable<OpenPlaDiC.Core.Models.User>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people-fill text-primary"></i> User Management</h2>
        <button class="btn btn-primary" onclick="showCreateUserModal()">
            <i class="bi bi-person-plus"></i> New User
        </button>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Folio</th>
                        <th>Name</th>
                        <th>Username / Email</th>
                        <th>Master</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td><small class="badge bg-light text-dark">@user.Folio</small></td>
                            <td><strong>@user.Name</strong></td>
                            <td>
                                <div>@user.Username</div>
                                <small class="text-muted">@user.Email</small>
                            </td>
                            <td>
                                @(user.IsMaster ? "⭐ Yes" : "No")
                            </td>
                            <td>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" @(user.IsActive ? "checked" : "") 
                                           onclick="toggleStatus('@user.Id')">
                                </div>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary"><i class="bi bi-shield-lock"></i> Roles</button>
                                <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>


    <div class="modal fade" id="rolesModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-shield-check"></i> Asignar Perfiles</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="roleUserId" />
                    <div id="rolesList" class="list-group">
                        <!-- Cargado por JS -->
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="createUserModal" tabindex="-1">
        <div class="modal-dialog">
            <form id="formCreateUser" class="modal-content">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="bi bi-person-plus-fill"></i> Nuevo Usuario</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Nombre Completo</label>
                            <input name="Name" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Usuario (Username)</label>
                            <input name="Username" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Correo Electrónico</label>
                            <input type="email" name="Email" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Contraseña Inicial</label>
                            <input type="password" name="rawPassword" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="IsMaster" value="true">
                                <label class="form-check-label">Privilegios de Super Usuario (Master)</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">Guardar Usuario</button>
                </div>
            </form>
        </div>
    </div>


</div>

<script>


    $('#formCreateUser').submit(function (e) {
        e.preventDefault();
        const data = $(this).serialize();

        $.post('/Security/CreateUser', data, function (res) {
            if (res.isSuccess) {
                Swal.fire('¡Éxito!', res.message, 'success').then(() => location.reload());
            } else {
                Swal.fire('Error', res.message, 'error');
            }
        });
    });

    function showCreateUserModal() {
        new bootstrap.Modal(document.getElementById('createUserModal')).show();
    }

    function toggleStatus(id) {
        $.post('/Security/ToggleUserStatus', { id: id }, function(res) {
            if(!res.isSuccess) Swal.fire('Error', 'No se pudo cambiar el estado', 'error');
        });
    }


    function openRolesModal(userId) {   
        $('#roleUserId').val(userId);
        $('#rolesList').html('<div class="text-center"><div class="spinner-border spinner-border-sm"></div></div>');
        
        $.get('/Security/GetUserRoles', { userId: userId }, function(data) {
            let html = '';
            data.forEach(role => {
                html += `
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        ${role.name}
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" ${role.hasRole ? 'checked' : ''} 
                                onclick="toggleRole('${userId}', '${role.id}')">
                        </div>
                    </div>`;
            });
            $('#rolesList').html(html);
            new bootstrap.Modal(document.getElementById('rolesModal')).show();
        });
    }

    function toggleRole(userId, profileId) {
        $.post('/Security/ToggleRole', { userId: userId, profileId: profileId }, function(res) {
            if(!res.isSuccess) Swal.fire('Error', res.message, 'error');
        });
    }



</script>
