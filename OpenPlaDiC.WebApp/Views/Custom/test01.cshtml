@using OpenPlaDiC.Framework
@using OpenPlaDiC.SF
@using System.Data
@model List<GlobalItem>

@inject ISFService SFService
@{

    DataTable table = null;
    List<Pedidos> list = new List<Pedidos>();
    List<ProductosPreventa> listPP = new List<ProductosPreventa>();

    string fechaConsulta = DateTime.Now.AddHours(-5).ToString("yyyy-MM-dd");

    var resp = await SFService.AuthSFAsync(
                        "3MVG9RezSyZYLh2ugNvdnHEjxlo0ip.U4p7wKX5F_0tRkB6VlsDLqEO.pZPhxXvhddQhj9hbyCgdT0ey9LOcE",
                        "3FA5714B7E3259CEE987D2A7AA657E68B5E283CB6B3DB8FDBB2D6DC941C60B78",
                        "jose.medina@ecuacorcias.com",
                        "Milagro2025+..",
                        "https://login.salesforce.com/services/oauth2/token"
                        );

    if(resp.IsSuccess)
    {
        var query = "select Id, Name, Latitud__c, Longitud__c, Estado__c, Fecha_hora_pedido__c, Vendedor__r.Name, Vendedor__r.Id, Total_cajas_30L__c, Total_de_cajas__c, Total_de_unidades__c, Modulo__r.Name, Modulo__r.Id, Monto_pedido__c, Cliente__r.Name from Pedido__c where Sucursal__c = 'a0pf2000004a2P5AAI' AND fecha__c =  "+fechaConsulta;
        var dataResp = await SFService.GetSOQLAsync(query, resp.Data);
        if(dataResp.IsSuccess)
        {
            table = dataResp.Data;
            if (table != null)
            {

                list = OpenPlaDiC.Framework.Helper.ConvertDataTable<Pedidos>(table);
                list.ForEach(p =>
                {
                    p.Fecha_hora_pedido__c = p.Fecha_hora_pedido__c.AddHours(-5);
                });

            }

        }


        query = "select  Producto__c, Producto__r.SKU__c SKU, Producto__r.Name Nombre, sum(Cajas__c) Cajas, sum(Unidades__c) Unidades, sum(Precio_total_plano__c) Total  " +
        "from Producto_Pedido__c where Pedido__r.Sucursal__c = 'a0pf2000004a2P5AAI' AND Pedido__r.fecha__c = " + fechaConsulta + " " +
        "group by  Producto__c, Producto__r.SKU__c, Producto__r.Name ORDER BY SUM(Cajas__c) DESC ";

        dataResp = await SFService.GetSOQLAsync(query, resp.Data);
        if (dataResp.IsSuccess)
        {
            table = dataResp.Data;
            if (table != null)
            {

                listPP = OpenPlaDiC.Framework.Helper.ConvertDataTable<ProductosPreventa>(table);
                listPP.ForEach(p => { p.Cajas = p.Cajas ?? 0; p.Unidades = p.Unidades ?? 0;  });

            }

        }


    };


}


@functions{

    public class Pedidos {
        public string Id  { get; set; }
        public string Name     { get; set; }
        public string Latitud__c  { get; set; }
        public string Longitud__c  { get; set; }
        public string Estado__c  { get; set; }
        public DateTime Fecha_hora_pedido__c     { get; set; }
        public string Vendedor__r_Name  { get; set; }
        public string Vendedor__r_Id   { get; set; }
        public double Total_cajas_30L__c  { get; set; }
        public double Total_de_cajas__c    { get; set; }
        public double Total_de_unidades__c  { get; set; }
        public string Modulo__r_Name   { get; set; }
        public string Modulo__r_Id  { get; set; }
        public double Monto_pedido__c { get; set; }
        public string Cliente__r_Name { get; set; }
    }

    public class ProductosPreventa {
        public string Producto__c   { get; set; }
        public string SKU     { get; set; }
        public string Nombre  { get; set; }
        public double? Cajas  { get; set; }
        public double? Unidades    { get; set; }
        public double Total  { get; set; }
    }
}


@{
    // Cálculos de Indicadores
    var totalPedidos = list.Count;
    var totalCajas = list.Sum(p => p.Total_de_cajas__c);
    var preventaTotal = list.Sum(p => p.Monto_pedido__c);
    var horasActivas = list.Select(p => p.Fecha_hora_pedido__c.Hour).Distinct().Count();
    var promedioPedidosHora = horasActivas > 0 ? (double)totalPedidos / horasActivas : 0;

    // Agrupación por Vendedor
    var statsPorVendedor = list.GroupBy(p => p.Vendedor__r_Name)
                                .Select(g => new {
                                    Vendedor = g.Key,
                                    Cantidad = g.Count(),
                                    Monto = g.Sum(p => p.Monto_pedido__c)
                                }).ToList().OrderByDescending(x => x.Monto);
}

<style>
    #mapaPedidos {
        height: 400px;
        width: 100%;
        border-radius: 8px;
        z-index: 1;
    }

    .card-indicator {
        transition: transform 0.2s;
    }

        .card-indicator:hover {
            transform: translateY(-5px);
        }
</style>

<!-- Estilos de DataTables para Bootstrap 5 -->
<link rel="stylesheet" href="https://cdn.datatables.net" />

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin="" />


<div class="container-fluid mt-3">
    <!-- SECCIÓN 1: INDICADORES -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary shadow-sm">
                <div class="card-body text-center">
                    <small>Total Pedidos</small>
                    <h3 class="mb-0">@totalPedidos</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success shadow-sm">
                <div class="card-body text-center">
                    <small>Total Cajas</small>
                    <h3 class="mb-0">@totalCajas</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning shadow-sm">
                <div class="card-body text-center">
                    <small>Preventa Total</small>
                    <h3 class="mb-0">@preventaTotal.ToString("C")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info shadow-sm">
                <div class="card-body text-center">
                    <small>Pedidos / Hora</small>
                    <h3 class="mb-0">@promedioPedidosHora.ToString("N1")</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- SECCIÓN 2: GRÁFICO -->
    <div class="row mb-4">
        <!-- SECCIÓN MAPA -->
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white fw-bold"><i class="bi bi-geo-alt"></i> Geolocalización de Pedidos</div>
                <div class="card-body p-0">
                    <div id="mapaPedidos"></div>
                </div>
            </div>
        </div>

        <!-- SECCIÓN GRÁFICO (Lado derecho del mapa) -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-bold">Eficiencia por Hora</div>
                <div class="card-body">
                    <canvas id="chartPedidosHora"></canvas>
                </div>
            </div>
        </div>
    </div>






    <div class="row">
        <!-- SECCIÓN 3: ESTADÍSTICA POR VENDEDOR (DataTable) -->
        <div class="col-md-5 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-dark text-white">Resumen por Vendedor</div>
                <div class="card-body">
                    <table id="tablaVendedores" class="table table-sm table-striped w-100">
                        <thead>
                            <tr>
                                <th>Vendedor</th>
                                <th class="text-center">Cant.</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in statsPorVendedor)
                            {
                                <tr>
                                    <td>@v.Vendedor</td>
                                    <td class="text-center">@v.Cantidad</td>
                                    <td class="text-end">@v.Monto.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- SECCIÓN 4: TABLA DE PEDIDOS (DataTable) -->
        <div class="col-md-7 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-dark text-white">Detalle de Pedidos</div>
                <div class="card-body">
                    <table id="tablaPedidos" class="table table-sm table-hover w-100">
                        <thead>
                            <tr>
                                <th>Hora</th>
                                <th>Pedido</th>
                                <th>Vendedor</th>
                                <th>Monto</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in list.OrderByDescending(x => x.Fecha_hora_pedido__c))
                            {
                                <tr>
                                    <td>@item.Fecha_hora_pedido__c.ToString("HH:mm")</td>
                                    <td>@item.Name</td>
                                    <td>@item.Vendedor__r_Name<br /><small class="text-secondary">@item.Cliente__r_Name</small></td>
                                    <td>@item.Monto_pedido__c.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-dark text-white">Resumen por Producto</div>
                <div class="card-body">
                    <table id="tablaProductos" class="table table-sm table-striped w-100">
                        <thead>
                            <tr>
                                <th>SKU</th>
                                <th>Producto</th>
                                <th class="text-center">Cajas</th>
                                <th class="text-center">Unidades</th>
                                <th class="text-end">Total</th>
                                <th class="text-center">Fecha último conteo</th>
                                <th class="text-center">Último conteo</th>
                                <th class="text-center">Entradas posteriores</th>
                                <th class="text-center">Salidas posteriores</th>
                                <th class="text-center">Stock estimado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in listPP.OrderByDescending(x => x.Total))
                            {
                                <tr>
                                    <td>@p.SKU</td>
                                    <td>@p.Nombre</td>
                                    <td class="text-center">@p.Cajas</td>
                                    <td class="text-center">@p.Unidades</td>
                                    <td class="text-end">@p.Total.ToString("C")</td>
                                    <td class="text-center" id="@("td1" + p.SKU)"><img src="~/images/loader.gif" width="24" /></td>
                                    <td class="text-center" id="@("td2" + p.SKU)"><img src="~/images/loader.gif" width="24" /></td>
                                    <td class="text-center" id="@("td3" + p.SKU)"><img src="~/images/loader.gif" width="24" /></td>
                                    <td class="text-center" id="@("td4" + p.SKU)"><img src="~/images/loader.gif" width="24" /></td>
                                    <td class="text-center" id="@("td5" + p.SKU)"><img src="~/images/loader.gif" width="24" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>


</div>

@Html.AntiForgeryToken()

<!-- SCRIPTS -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>


<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
        crossorigin=""></script>

<script>


    // To prevent Cross-Site Request Forgery (CSRF), you need to include the
    // anti-forgery token in your request headers. The token is generated by
    // the Form Tag Helper or Html Helper in your Razor view.
    const antiForgeryToken = $('input[name="__RequestVerificationToken"]').val();




    $(document).ready(function () {
        // Inicializar Mapa

            const mapElement = document.getElementById('mapaPedidos');
            if (mapElement) {
                const map = L.map('mapaPedidos').setView([0, 0], 2);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '© OpenStreetMap'
                }).addTo(map);

                const markers = [];
                @foreach (var p in list.Where(x => !string.IsNullOrEmpty(x.Latitud__c)))
                {
                        <text>
                        var marker = L.marker([@p.Latitud__c, @p.Longitud__c])
                            .bindPopup("<b>Pedido: @p.Name</b><br>Vendedor: @p.Vendedor__r_Name<br>Monto: @p.Monto_pedido__c.ToString("C")")
                            .addTo(map);
                        markers.push([@p.Latitud__c, @p.Longitud__c]);
                        </text>
                }

                if (markers.length > 0) {
                    map.fitBounds(markers);
                }
            }



        // Inicializar DataTable de Vendedores
        $('#tablaVendedores').DataTable({
            language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json' },
            paging: false,
            searching: false,
            info: false,
            ordering: false,
        });

        // Inicializar DataTable de Pedidos
        $('#tablaPedidos').DataTable({
            language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json' },
            pageLength: 5,
            lengthMenu: [5, 10, 25],
            ordering: false,
        });

        // Inicializar DataTable de Productos
        $('#tablaProductos').DataTable({
            language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json' },
            paging: false,
            info: false,
            ordering: false,
        });

        // Lógica del Gráfico (Chart.js)
        const ctx = document.getElementById('chartPedidosHora').getContext('2d');
        const labelsHoras = ['06:00', '07:00', '08:00', '09:00', '10:00', '11:00', '12:00', '13:00', '14:00', '15:00', '16:00', '17:00', '18:00'];
        
        const data = {
            labels: labelsHoras,
            datasets: [
                @foreach (var vend in list.Select(p => p.Vendedor__r_Name).Distinct())
                {
                    var dataPoints = new List<int>();
                    for(int h = 6; h <= 18; h++) {
                        dataPoints.Add(list.Count(p => p.Vendedor__r_Name == vend && p.Fecha_hora_pedido__c.Hour == h));
                    }
                    <text>
                    {
                        label: '@vend',
                        data: [@string.Join(",", dataPoints)],
                        borderWidth: 2,
                        tension: 0.3
                    },
                    </text>
                }
            ]
        };

        new Chart(ctx, {
            type: 'line',
            data: data,
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } }
            }
        });


        consultarStockEstimado();


    });


    async function consultarStockEstimado() {


        const req = { procName: "sp_ObtenerStockEstimado", parameters: null };      



        // fetch('/API/GetProcData', {
        //     method: 'POST',
        //     headers: {
        //         'Content-Type': 'application/json',
        //         'Accept': 'application/json',
        //         'RequestVerificationToken': antiForgeryToken
        //     },
        //     body: JSON.stringify(req) // Convert the JavaScript object to a JSON string
        // }).then((response) => {
        
        //     r = response.json();
        //     console.log(r);
        //     });


        // if (!response.ok) {
        //     //throw new Error(`HTTP error! status: ${response.status}`);
        // }
        // else {


        // }



        // //const result = await response.json();
        // //console.log(result.message);


        // Regla: Enviar null para procedimientos sin parámetros
        getProcDataAsync("sp_ObtenerStockEstimado", null, antiForgeryToken,
