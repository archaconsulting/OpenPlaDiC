@model OpenPlaDiC.Core.ViewModels.ErrorViewModel

<div class="container mt-5">
    <div class="card border-danger shadow">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0"><i class="bi bi-bug-fill"></i> Kernel Exception Detected</h4>
        </div>
        <div class="card-body">
            <h5 class="text-danger">@Model.ExceptionMessage</h5>
            <p class="text-muted">An error occurred while processing your request in: <strong>@Model.Path</strong></p>
            
            @if (User.HasClaim("IsMaster", "True"))
            {
                <div class="mt-4">
                    <h6>Technical Details (Master View):</h6>
                    <pre class="bg-light p-3 border rounded" style="font-size: 0.8rem; max-height: 400px; overflow-y: auto;">@Model.StackTrace</pre>
                </div>
            }
        </div>
        <div class="card-footer bg-transparent">
            <a href="javascript:history.back()" class="btn btn-outline-secondary">Go Back</a>
            <a href="/" class="btn btn-primary">Return to Dashboard</a>
        </div>
    </div>
</div>
