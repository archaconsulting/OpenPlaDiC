@using System.Data
@using OpenPlaDiC.Core.Models
@model OpenPlaDiC.WebApp.Models.DynamicIndexViewModel
@{
    // Mantengo tus variables de control de acceso del Kernel
    var access = (AccessControl)ViewBag.Access;
    
    // Ahora leemos la información central directamente de la metadata del ViewModel
    var entityName = Model.EntityMetadata.Name;
    var entityLabel = Model.EntityMetadata.Label ?? "Entidad Dinámica";
    var nameLabel = Model.EntityMetadata.NameLabel ?? "Nombre / Razón Social";

    ViewData["Title"] = entityLabel;
}

@{
    // Helper para transformar el string "0:Transportista,1:Taller" en un Diccionario de C#
    Dictionary<int, string> ParseListValues(string? sourceDefinition)
    {
        var dictionary = new Dictionary<int, string>();
        if (string.IsNullOrWhiteSpace(sourceDefinition)) return dictionary;

        var items = sourceDefinition.Split(',');
        foreach (var item in items)
        {
            var parts = item.Split(':');
            if (parts.Length == 2 && int.TryParse(parts[0], out int key))
            {
                dictionary[key] = parts[1];
            }
        }
        return dictionary;
    }

    // Helper para recuperar valores de filtros de manera segura sin romper si la llave no existe
    string GetFilterValue(string key) => Model.CurrentFilters.ContainsKey(key) ? Model.CurrentFilters[key] : "";
}

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-filter me-2"></i> Filtros Avanzados Específicos</h5>
        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#filterPanel">
            <i class="fas fa-chevron-down"></i>
        </button>
    </div>
    <div id="filterPanel" class="collapse show card-body">
        <form action="/Data/@entityName" method="GET" autocomplete="off">
            <div class="row g-3">
                @foreach (var prop in Model.EntityMetadata.Properties)
                {
                    // Regla de negocio: Solo renderizar filtros para propiedades marcadas para mostrarse en el Grid
                    if (prop.OnList == true)
                    {
                        <div class="col-md-4 filter-group-box" data-property-type="@prop.DataTypeId">
                            <label class="form-label fw-bold small text-muted mb-1 d-block">@prop.Label</label>

                            @if (prop.DataTypeId == 10) // RelatedEntity (Lookup / Relacional)
                            {
                                var currentOp = GetFilterValue($"{prop.Name}_operator");
                                var currentV1 = GetFilterValue($"{prop.Name}_value1");

                                <div class="input-group input-group-sm">
                                    <input type="hidden" name="@(prop.Name)_operator" value="Equals" />
                                    <select name="@(prop.Name)_value1" class="form-select">
                                        <option value="">-- Todos --</option>
                                        @* Los <option> se cargan dinámicamente o por backend *@
                                    </select>
                                </div>
                            }
                            else if (prop.DataTypeId == 11) // Booleano / Switch / Bit Activo
                            {
                                var currentOp = GetFilterValue($"{prop.Name}_operator");
                                <select name="@(prop.Name)_operator" class="form-select form-select-sm">
                                    <option value="">-- Todos --</option>
                                    <option value="Active" selected="@(currentOp == "Active")">Sí</option>
                                    <option value="Inactive" selected="@(currentOp == "Inactive")">NoInactivos / Falsos</option>
                                </select>
                            }
                            else if (prop.DataTypeId == 17) // Listas estáticas por comas
                            {
                                var currentOp = GetFilterValue($"{prop.Name}_operator");
                                var currentV1 = GetFilterValue($"{prop.Name}_value1");
                                var opciones = ParseListValues(prop.SourceDefinition);

                                <div class="input-group input-group-sm">
                                    <input type="hidden" name="@(prop.Name)_operator" value="Equals" />
                                    <select name="@(prop.Name)_value1" class="form-select">
                                        <option value="">-- Todos --</option>
                                        @foreach (var opt in opciones)
                                        {
                                            <option value="@opt.Key" selected="@(currentV1 == opt.Key.ToString())">@opt.Value</option>
                                        }
                                    </select>
                                </div>
                            }
                            else if (prop.DataTypeId == 4) // Campos Tipo Fecha / DateTime (Filtros dinámicos de rango y períodos)
                            {
                                var currentOp = GetFilterValue($"{prop.Name}_operator");
                                var currentV1 = GetFilterValue($"{prop.Name}_value1");
                                var currentV2 = GetFilterValue($"{prop.Name}_value2");

                                <div class="d-flex flex-column gap-1">
                                    <select name="@(prop.Name)_operator" class="form-select form-select-sm date-operator-select" onchange="toggleDateInputs(this)">
                                        <option value="Equals" selected="@(currentOp == "Equals" || string.IsNullOrEmpty(currentOp))">Es Igual a...</option>
                                        <option value="Between" selected="@(currentOp == "Between")">Está Entre (Rango)</option>
                                        <option value="GreaterThanOrEqual" selected="@(currentOp == "GreaterThanOrEqual")">Desde (>=)</option>
                                        <option value="LessThanOrEqual" selected="@(currentOp == "LessThanOrEqual")">Hasta </option>
                                        <option value="Today" selected="@(currentOp == "Today")">Hoy</option>
                                        <option value="Yesterday" selected="@(currentOp == "Yesterday")">Ayer</option>
                                        <option value="ThisMonth" selected="@(currentOp == "ThisMonth")">Este Mes</option>
                                    </select>

                                    <div class="input-group input-group-sm date-inputs-container">
                                        <input type="date" name="@(prop.Name)_value1" value="@currentV1" class="form-control date-v1" placeholder="Fecha" />
                                        <span class="input-group-text bg-white border-start-0 border-end-0 date-range-sep d-none">a</span>
                                        <input type="date" name="@(prop.Name)_value2" value="@currentV2" class="form-control date-v2 d-none" placeholder="Hasta" />
                                    </div>
                                </div>
                            }
                            else if (prop.DataTypeId == 1 || prop.DataTypeId == 2) // Numéricos (Enteros, Decimales, Monedas)
                            {
                                var currentOp = GetFilterValue($"{prop.Name}_operator");
                                var currentV1 = GetFilterValue($"{prop.Name}_value1");
                                var currentV2 = GetFilterValue($"{prop.Name}_value2");

                                <div class="d-flex flex-column gap-1">
                                    <select name="@(prop.Name)_operator" class="form-select form-select-sm numeric-operator-select" onchange="toggleNumericInputs(this)">
                                        <option value="Equals" selected="@(currentOp == "Equals" || string.IsNullOrEmpty(currentOp))">Igual (=)</option>
                                        <option value="Between" selected="@(currentOp == "Between")">Entre (Rango)</option>
                                        <option value="GreaterThan" selected="@(currentOp == "GreaterThan")">Mayor que (>)</option>
                                        <option value="LessThan" selected="@(currentOp == "LessThan")">Menor que </option>
                                        <option value="GreaterThanOrEqual" selected="@(currentOp == "GreaterThanOrEqual")">Mayor o Igual (>=)</option>
                                        <option value="LessThanOrEqual" selected="@(currentOp == "LessThanOrEqual")">Menor o Igual </option>
                                    </select>

                                    <div class="input-group input-group-sm numeric-inputs-container">
                                        <input type="number" step="any" name="@(prop.Name)_value1" value="@currentV1" class="form-control numeric-v1" placeholder="Valor" />
                                        <span class="input-group-text bg-white border-start-0 border-end-0 numeric-range-sep d-none">a</span>
                                        <input type="number" step="any" name="@(prop.Name)_value2" value="@currentV2" class="form-control numeric-v2 d-none" placeholder="Máx" />
                                    </div>
                                </div>
                            }
                            else // Strings / Alfanuméricos por defecto
                            {
                                var currentOp = GetFilterValue($"{prop.Name}_operator");
                                var currentV1 = GetFilterValue($"{prop.Name}_value1");

                                <div class="d-flex flex-column gap-1">
                                    <select name="@(prop.Name)_operator" class="form-select form-select-sm">
                                        <option value="Contains" selected="@(currentOp == "Contains" || string.IsNullOrEmpty(currentOp))">Contiene</option>
                                        <option value="StartsWith" selected="@(currentOp == "StartsWith")">Empieza con</option>
                                        <option value="EndsWith" selected="@(currentOp == "EndsWith")">Termina con</option>
                                        <option value="Equals" selected="@(currentOp == "Equals")">Es Exactamente Igual A</option>
                                        <option value="NotContains" selected="@(currentOp == "NotContains")">No Contiene</option>
                                    </select>
                                    <input type="text" name="@(prop.Name)_value1" value="@currentV1" class="form-control form-control-sm" placeholder="Texto a buscar..." />
                                </div>
                            }
                        </div>
                    }
                }
            </div>
            <div class="d-flex justify-content-end mt-3 gap-2">
                <a href="/Data/@entityName" class="btn btn-sm btn-light border">Limpiar Filtros</a>
                <button type="submit" class="btn btn-sm btn-primary">Aplicar Filtros</button>
            </div>
        </form>
    </div>
</div>

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 mb-0 text-gray-800">
                @entityLabel
            </h2>
            <p class="text-muted small mb-0">Gestión de registros para la entidad: <code>@entityName</code></p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Data/@entityName/Export" class="btn btn-sm btn-outline-success d-flex align-items-center gap-1">
                <i class="bi bi-file-earmark-excel"></i> Exportar Excel
            </a>

            @if (access.CanCreate)
            {
                <a class="btn btn-primary" href="/Data/@entityName/Edit">
                    <i class="bi bi-plus-lg"></i> Nuevo Registro
                </a>
            }
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="dynamicTable">
                    <thead class="table-light border-bottom">
                        <tr>
                            <th class="ps-4" style="width: 100px;">Folio</th>
                            
                            @foreach (var prop in Model.EntityMetadata.Properties)
                            {
                                if (prop.OnList == true)
                                {
                                    if (prop.Name.ToUpper().Equals("NAME"))
                                    {
                                        <th>@nameLabel</th>
                                    }
                                    else
                                    {
                                        <th>@prop.Label</th>
                                    }
                                }
                            }
                            <th class="text-end pe-4" style="width: 130px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Data == null || !Model.Data.Any())
                        {
                            <tr>
                                <td colspan="100%" class="text-center py-5 text-muted">
                                    <i class="bi bi-folder2-open display-4 d-block mb-3"></i>
                                    No se encontraron registros para @entityLabel.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in Model.Data)
                            {
                                <tr>
                                    <td class="ps-4">
                                        @{ var folioVal = row.ContainsKey("Folio") ? row["Folio"]?.ToString() : "-"; }
                                        @{ bool deletedRow = row.ContainsKey("IsDeleted") && Convert.ToBoolean(row["IsDeleted"]); }

                                        <span class="badge @( deletedRow ? "bg-secondary text-light": "bg-light text-primary") border fw-bold">@folioVal</span>
                                    </td>
                                    
                                    @foreach (EntityProperty prop in Model.EntityMetadata.Properties)
                                    {
                                        if (prop.OnList == true)
                                        {
                                            
                                                @if (row.ContainsKey(prop.Name) && row[prop.Name] != null && row[prop.Name] != DBNull.Value)
                                                {
                                                    var rawVal = row[prop.Name];

                                                    if (prop.DataTypeId == 11 || rawVal is bool)
                                                    {
                                                        var isChecked = rawVal.ToString() == "1" || rawVal.ToString().ToLower() == "true";
                                                        <td align="center">
                                                            <i class="bi @(isChecked ? "bi-check-circle-fill text-success" : "bi-x-circle text-muted")"></i>
                                                        </td>
                                                    }
                                                    else if (prop.DataTypeId == 3 || prop.DataTypeId == 103)
                                                    {
                                                        <td>
                                                            @Convert.ToDateTime(rawVal).ToString("dd/MM/yyyy HH:mm")
                                                        </td>
                                                    }
                                                    else if (prop.DataTypeId == 2 )
                                                    {
                                                        <td align="right">
                                                            @Convert.ToDecimal(rawVal).ToString("N2")
                                                        </td>
                                                    }                                                    
                                                    else if (prop.DataTypeId == 17)
                                                    {
                                                        var opciones = ParseListValues(prop.SourceDefinition);
                                                        if (int.TryParse(rawVal?.ToString(), out int intKey) && opciones.ContainsKey(intKey))
                                                        {
                                                            <td>
                                                                <span class="badge bg-light text-dark border">@opciones[intKey]</span>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td>
                                                                <span class="text-muted">-</span>
                                                            </td>
                                                        }
                                                    } 
                                                    else if (prop.DataTypeId == 18) // Tipo de Dato Image (18)
                                                    {
                                                        var imgVal = rawVal?.ToString();
                                                        if (!string.IsNullOrEmpty(imgVal))
                                                        {
                                                            string imgSrc = imgVal.StartsWith("data:image") ? imgVal : $"/uploads/{imgVal}";
                                                            <td>
                                                                <a href="@imgSrc" target="_blank" title="Ver imagen en tamaño completo">
                                                                    <img src="@imgSrc" alt="@prop.Label" class="img-thumbnail shadow-sm" style="max-height: 40px; max-width: 60px; object-fit: cover; border-radius: 4px;" />
                                                                </a>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td>
                                                                <span class="text-muted small"><i class="bi bi-image text-black-50 me-1"></i>Sin imagen</span>
                                                            </td>
                                                        }
                                                    }
                                                    else if (prop.DataTypeId == 19) // Tipo de Dato Url (19)
                                                    {
                                                        var urlVal = rawVal?.ToString();
                                                        if (!string.IsNullOrEmpty(urlVal))
                                                        {
                                                            var formattedUrl = urlVal.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || urlVal.StartsWith("https://", StringComparison.OrdinalIgnoreCase) 
                                                                ? urlVal 
                                                                : $"https://{urlVal}";

                                                            <td>
                                                                <a href="@formattedUrl" target="_blank" rel="noopener noreferrer" class="btn btn-xs btn-link text-decoration-none px-0 fw-semibold">
                                                                    <i class="bi bi-box-arrow-up-right me-1"></i> Abrir Enlace
                                                                </a>
                                                            </td>

                                                        }
                                                        else
                                                        {
                                                            <td>
                                                                <span class="text-muted small">-</span>
                                                            </td>
                                                        }
                                                    }



                                                    else
                                                    {
                                                        <td>
                                                            @rawVal.ToString()
                                                        </td>
                                                    }
                                                }
                                                else
                                                {
                                                    <td>
                                                        <span class="text-muted small">-</span>
                                                    </td>
                                                }
                                            
                                        }
                                    }

                                    <td class="text-end pe-4">
                                        @{
                                            var rowId = row.ContainsKey("Id") ? row["Id"]?.ToString() : "";
                                            var rowFolio = row.ContainsKey("Folio") ? row["Folio"]?.ToString() : "";
                                        }
                                        <div class="btn-group shadow-sm">
                                            @if (!deletedRow && access.CanUpdate)
                                            {
                                                <a class="btn btn-primary" href="/Data/@entityName/Edit/@rowId">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            }
                                            @if (!deletedRow && access.CanDelete)
                                            {
                                                <button class="btn btn-danger" onclick="confirmDelete('@entityName', '@rowId', '@rowFolio')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-white d-flex justify-content-between align-items-center border-top">
                @if (Model.EntityMetadata.PageSize > 0)
                {
                    <div class="text-muted small">
                        Tamaño de página: <span class="fw-bold">@Model.EntityMetadata.PageSize</span> registros.
                    </div>
                    <nav aria-label="Navegación de páginas">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                <a class="page-link" href="@BuildPageUrl(Model.CurrentPage - 1)">Anterior</a>
                            </li>
                            
                            <li class="page-item active">
                                <span class="page-link">Página @Model.CurrentPage</span>
                            </li>

                            @{
                                int pageSize = Model.EntityMetadata.PageSize;
                                bool hasNextPage = Model.Data != null && Model.Data.Count() == pageSize;
                            }
                            <li class="page-item @(!hasNextPage ? "disabled" : "")">
                                <a class="page-link" href="@BuildPageUrl(Model.CurrentPage + 1)">Siguiente</a>
                            </li>
                        </ul>
                    </nav>
                }
                else
                {
                    <div class="text-muted small w-100 text-center py-1">
                        <i class="bi bi-info-circle me-1 text-primary"></i> 
                        Vista completa activa: Mostrando todos los registros disponibles (<span class="fw-bold">@Model.Data.Count()</span>).
                    </div>
                }
            </div>

            @functions {
                string BuildPageUrl(int targetPage)
                {
                    var queryParams = new List<string> { $"page={targetPage}" };
                    foreach (var filter in Model.CurrentFilters)
                    {
                        if (filter.Key != "page" && !string.IsNullOrWhiteSpace(filter.Value))
                        {
                            queryParams.Add($"{filter.Key}={Uri.EscapeDataString(filter.Value)}");
                        }
                    }
                    return $"/Data/{Model.EntityMetadata.Name}?" + string.Join("&", queryParams);
                }
            }

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(entity, id, folio) {
            Swal.fire({
                title: '¿Eliminar registro?',
                text: `Estás por marcar el folio ${folio} como eliminado de forma lógica.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = `/Data/${entity}/Delete/${id}`;
                }
            });
        }

        // Control dinámico de Inputs para Fechas basándose en el Operador Seleccionado
        function toggleDateInputs(selectElement) {
            const container = selectElement.closest('.d-flex');
            const v1 = container.querySelector('.date-v1');
            const v2 = container.querySelector('.date-v2');
            const sep = container.querySelector('.date-range-sep');
            const val = selectElement.value;

            if (val === 'Between') {
                v1.classList.remove('d-none');
                v2.classList.remove('d-none');
                sep.classList.remove('d-none');
            } else if (val === 'Today' || val === 'Yesterday' || val === 'ThisMonth') {
                v1.classList.add('d-none');
                v2.classList.add('d-none');
                sep.classList.add('d-none');
                v1.value = '';
                v2.value = '';
            } else {
                v1.classList.remove('d-none');
                v2.classList.add('d-none');
                sep.classList.add('d-none');
                v2.value = '';
            }
        }

        // Control dinámico de Inputs para Números basándose en el Operador Seleccionado
        function toggleNumericInputs(selectElement) {
            const container = selectElement.closest('.d-flex');
            const v1 = container.querySelector('.numeric-v1');
            const v2 = container.querySelector('.numeric-v2');
            const sep = container.querySelector('.numeric-range-sep');
            const val = selectElement.value;

            if (val === 'Between') {
                v1.classList.remove('d-none');
                v2.classList.remove('d-none');
                sep.classList.remove('d-none');
            } else {
                v1.classList.remove('d-none');
                v2.classList.add('d-none');
                sep.classList.add('d-none');
                v2.value = '';
            }
        }

        // Ejecutar al cargar la página para mantener consistencia visual si hay filtros aplicados previos
        document.addEventListener("DOMContentLoaded", function() {
            document.querySelectorAll('.date-operator-select').forEach(el => toggleDateInputs(el));
            document.querySelectorAll('.numeric-operator-select').forEach(el => toggleNumericInputs(el));
        });
    </script>
}

<style>
    .btn-white { background-color: #fff; }
    .btn-white:hover { background-color: #f8f9fa; }
    #dynamicTable th { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; }
    .filter-group-box { background-color: #fcfcfc; border: 1px solid #f1f1f1; padding: 10px; border-radius: 6px; }
</style>