<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OpenPlaDiC.WebApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />


    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.6/css/dataTables.bootstrap5.min.css">


    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">




    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.datatables.net/2.3.6/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.6/js/dataTables.bootstrap5.min.js"></script>
    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>

</head>
<body>

    <div class="d-flex">

        <!-- Sidebar Dinámico -->
        @if (User.Identity.IsAuthenticated)
        {
            @await Component.InvokeAsync("Sidebar")
        }

        <div class="w-100 p-0">

            <header>
                <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                    <div class="container-fluid">
                        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                            <img src="/images/pladic.png" height="48"/>


                        </a>
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                                aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                            <ul class="navbar-nav flex-grow-1">
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                                </li>

                                @if (User != null && User.Identities != null && User.Identity.IsAuthenticated && Convert.ToBoolean( User.FindFirst("IsMaster")?.Value) )
                                {

                                    <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownMenuLink" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-wrench-adjustable"></i>&nbsp; Configuration
                                        </a>
                                        <ul class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">

                                            <li><a class="dropdown-item" href="/DynamicView">Views</a></li>
                                            <li><a class="dropdown-item" href="#">Bandeja de entrada</a></li>

                                            <li><hr class="dropdown-divider"></li>

                                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Logout">Cerrar sesión</a></li>
                                        </ul>

                                    </li>

                                }
                            
                            </ul>


                            <ul class="navbar-nav ms-auto">
                                @if (User != null && User.Identities != null && User.Identity.IsAuthenticated)
                                {
                                    


                                    <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownMenuLink" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <img class="card-img-top rounded-circle" src="/images/user.png" style="height:32px; width:32px" />&nbsp; @User.FindFirst("FullName")?.Value
                                        </a>
                                        <ul class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">

                                            <li><a class="dropdown-item" href="#">Mi cuenta</a></li>
                                            <li><a class="dropdown-item" href="#">Bandeja de entrada</a></li>

                                            <li><hr class="dropdown-divider"></li>

                                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Logout">Cerrar sesión</a></li>
                                        </ul>

                                    </li>

                                }
                                else
                                {
                                    <li> <a asp-controller="Account" asp-action="Login">log in</a></li>
                                }


                            </ul>




                        </div>
                    </div>
                </nav>
            </header>

            <main role="main" class="container-fluid px-4">
                <div class="mt-3">
                    @await Component.InvokeAsync("Breadcrumb")
                </div>
                @RenderBody()
            </main>

        </div>




    <!-- Modal de búsqueda genérico -->
    <div class="modal fade" id="lookupModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="lookupTitle">Seleccionar Registro</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="input-group mb-3">
                        <input type="text" id="lookupSearch" class="form-control" placeholder="Buscar por nombre o folio...">
                        <button class="btn btn-outline-primary" type="button" onclick="executeLookup()">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                    <div id="lookupResults" class="list-group">
                        <!-- Resultados vía AJAX -->
                    </div>
                </div>
            </div>
        </div>
    </div>




    <footer class="border-top footer text-muted">
        <div class="container">
            @await Component.InvokeAsync("GlobalSearch")
            <br />

            &copy; 2026 - OpenPlaDiC.WebApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>


    </div>

    <script>
        window.AppUser = {
            id: '@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value',
            userName: '@User.Identity?.Name',
            fullName: '@User.FindFirst("FullName")?.Value',
            isAuthenticated: @User.Identity?.IsAuthenticated.ToString().ToLower(),
            token: '@Html.AntiForgeryToken()'
        };



        // Views/Shared/_Layout.cshtml (Sección de Scripts)
        let idleTime = 0;
        const maxIdleMinutes = 20; // Debe coincidir con el servidor

        $(document).ready(function () {
            // Incrementar el contador cada minuto
            const idleInterval = setInterval(timerIncrement, 60000); 

            // Reiniciar el contador si hay movimiento
            $(this).mousemove(function (e) { idleTime = 0; });
            $(this).keypress(function (e) { idleTime = 0; });
        });

        function timerIncrement() {
            idleTime++;
            if (idleTime >= maxIdleMinutes - 2) { 
                // Avisar 2 minutos antes de expirar
                Swal.fire({
                    title: 'Session expiring',
                    text: 'Your session is about to expire due to inactivity.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Stay connected',
                    cancelButtonText: 'Logout now'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Hacer una petición simple al servidor para refrescar la cookie
                        fetch('/Dashboard/KeepAlive'); 
                        idleTime = 0;
                    } else {
                        window.location.href = '/Auth/Logout';
                    }
                });
            }
            if (idleTime >= maxIdleMinutes) {
                window.location.href = '/Auth/Logout?reason=timeout';
            }
        }





    </script>


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
