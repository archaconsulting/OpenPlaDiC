@using System.Data
@model List<OpenPlaDiC.Web.Components.RelatedTableViewModel>

@{
    // Obtenemos la URL actual del padre (ej: /DynamicEntity/Edit/GuidPadre)
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
}    

<div class="d-flex flex-column gap-3">
    @foreach (var rel in Model)
    {
        <div class="card shadow-sm border-0 border-top border-3 border-secondary">
            <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                <h6 class="m-0 fw-bold text-secondary"><i class="bi bi-link-45deg"></i> @rel.EntityLabel</h6>


                @* <!-- Botón para agregar un nuevo registro hijo heredando el ID del padre -->
                <a href="/Data/@rel.EntityName/Edit?@rel.ForeignKeyName=@ViewBag.ParentRecordId" class="btn btn-sm btn-outline-primary py-0 px-2">
                    <i class="bi bi-plus"></i> Nuevo
                </a> *@

                <!-- Botón Agregar Relacionado -->
                <a href="/Data/@rel.EntityName/Edit?@rel.ForeignKeyName=@ViewBag.ParentRecordId&entityName=Hijo&returnUrl=@Url.PageLink(currentUrl)" 
                class="btn btn-sm btn-primary">
                    <i class="fa-solid fa-plus me-1"></i> Agregar Registro
                </a>


            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0 style-table">
                        <thead>
                            <tr class="table-light">
                                <th class="ps-3">Folio</th>
                                <th>Descripción</th>
                                <th class="text-end pe-3">Ver</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (rel.Data.Rows.Count == 0)
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-3 text-muted small">No hay registros asociados.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (DataRow row in rel.Data.Rows)
                                {
                                    <tr>
                                        <td class="ps-3"><span class="badge bg-light text-dark border">@row["Folio"]</span></td>
                                        <td class="text-truncate" style="max-width: 150px;">@row["Name"]</td>
                                        <td class="text-end pe-3">
                                            @* <a href="/Data/@rel.EntityName/Edit/@row["Id"]" class="btn btn-sm p-0 text-primary">
                                                <i class="bi bi-eye"></i>
                                            </a> *@


                                            <!-- Botón Editar Relacionado (dentro de la tabla de hijos) -->
                                            <a href="/Data/@rel.EntityName/Edit/@row["Id"]?entityName=Hijo&returnUrl=@Url.PageLink(currentUrl)" 
                                            class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-pencil"></i>
                                            </a>


                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .style-table th { font-size: 0.75rem; text-transform: uppercase; }
    .style-table td { font-size: 0.85rem; }
</style>
