@model List<OpenPlaDiC.Core.Models.Record>
@{
    ViewData["Title"] = "Resultados de búsqueda";
}

<div class="container mt-4">
    <h4>Resultados para: <span class="text-primary">@ViewBag.Term</span></h4>
    <hr />

    <div class="list-group shadow-sm">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                
                    
                    <div class="d-flex w-100 justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <div class="bg-primary bg-opacity-10 p-2 rounded me-3 text-center" style="width: 50px;">
                                <i class="bi @(string.IsNullOrEmpty(item.Entity.Icon) ? "bi-layers" : item.Entity.Icon) fs-4 text-primary"></i>
                            </div>
                            <div>
                                <h5 class="mb-1">@item.Folio</h5>
                                <p class="mb-0 text-muted">
                                    <strong>@item.Entity.NameLabel:</strong> @item.SearchContent
                                </p>
                                <span class="badge bg-light text-dark border mt-1">@item.Entity.Label</span>
                            </div>
                        </div>
                        <div class="text-end">
                            <small class="text-muted d-block">@item.CreatedAt.ToString("dd/MM/yyyy")</small>
                            <i class="bi bi-chevron-right text-primary"></i>
                        </div>
                    </div>
                
            }
        }
        else
        {
            <div class="alert alert-light border text-center p-5">
                <i class="bi bi-search fs-1 text-muted"></i>
                <p class="mt-3 mb-0">No se encontraron registros que coincidan con la búsqueda.</p>
            </div>
        }
    </div>
</div>
